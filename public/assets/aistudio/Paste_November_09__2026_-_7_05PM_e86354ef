  <!-- AXION Interaction Orchestrator (Client-Side JS Engine) -->
  <script>
    // Live Telemetry Inspector Updater
    const triggerLabel = document.getElementById('telemetry-trigger');
    const actionLabel = document.getElementById('telemetry-action');
    const timingLabel = document.getElementById('telemetry-timing');

    function logTelemetry(trigger, action, ms) {
      triggerLabel.textContent = trigger;
      actionLabel.textContent = action;
      timingLabel.textContent = ms + 'ms';
    }

    // 01. Tap Response Button
    const tapDemoBtn = document.getElementById('btn-tap-demo');
    tapDemoBtn.addEventListener('click', () => {
      logTelemetry('POINTER_TAP', 'Scale compress 0.965 → Rebound Settle', 140);
    });

    // 02 & 03. Origin-Emergent Dropdown
    const dropdownTrigger = document.getElementById('dropdown-trigger');
    const dropdownMenu = document.getElementById('dropdown-menu');
    const dropdownChevron = document.getElementById('dropdown-chevron');
    let isDropdownOpen = false;

    dropdownTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      isDropdownOpen = !isDropdownOpen;
      if (isDropdownOpen) {
        dropdownMenu.classList.remove('opacity-0', 'scale-95', '-translate-y-2', 'pointer-events-none');
        dropdownChevron.classList.add('rotate-180');
        logTelemetry('CONTROL_TAP', 'Menu emerges from anchor origin', 220);
      } else {
        closeDropdown();
      }
    });

    function closeDropdown() {
      isDropdownOpen = false;
      dropdownMenu.classList.add('opacity-0', 'scale-95', '-translate-y-2', 'pointer-events-none');
      dropdownChevron.classList.remove('rotate-180');
      logTelemetry('DISMISS', 'Menu contracts into anchor', 180);
    }

    document.querySelectorAll('.dropdown-item').forEach(item => {
      item.addEventListener('click', (e) => {
        e.stopPropagation();
        const subject = item.getAttribute('data-subject');
        const color = item.getAttribute('data-color');
        document.getElementById('selected-subject-text').textContent = subject;
        document.getElementById('selected-subject-dot').className = `w-2 h-2 rounded-full ${color}`;
        closeDropdown();
        logTelemetry('OPTION_SELECT', `Value settled: ${subject}`, 200);
      });
    });

    window.addEventListener('click', () => {
      if (isDropdownOpen) closeDropdown();
    });

    // 04. In-Situ List Item Morph
    const listItemMorph = document.getElementById('list-item-morph');
    const listItemDetails = document.getElementById('list-item-details');
    const listItemArrow = document.getElementById('list-item-arrow');
    let isItemExpanded = false;

    listItemMorph.addEventListener('click', () => {
      isItemExpanded = !isItemExpanded;
      if (isItemExpanded) {
        listItemDetails.style.maxHeight = '120px';
        listItemDetails.classList.remove('opacity-0');
        listItemDetails.classList.add('opacity-100');
        listItemArrow.classList.add('rotate-90');
        logTelemetry('ITEM_TOUCH', 'In-situ height & alpha expansion', 260);
      } else {
        listItemDetails.style.maxHeight = '0px';
        listItemDetails.classList.remove('opacity-100');
        listItemDetails.classList.add('opacity-0');
        listItemArrow.classList.remove('rotate-90');
        logTelemetry('ITEM_CONTRACT', 'Collapsed back to single row', 220);
      }
    });

    // 05 & 06. Plus → Diagonal Window Expansion
    const btnPlusOrigin = document.getElementById('btn-plus-origin');
    const modalPlusWindow = document.getElementById('modal-plus-window');
    const modalPlusContent = document.getElementById('modal-plus-content');
    const btnClosePlusModal = document.getElementById('btn-close-plus-modal');
    const btnCancelPlus = document.getElementById('btn-cancel-plus');
    const btnConfirmPlus = document.getElementById('btn-confirm-plus');

    function openPlusModal() {
      modalPlusWindow.classList.remove('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        modalPlusContent.classList.remove('scale-75', '-translate-x-12', 'translate-y-12', 'opacity-0');
        modalPlusContent.classList.add('scale-100', 'translate-x-0', 'translate-y-0', 'opacity-100');
      }, 10);
      logTelemetry('PLUS_RADIAL', 'Diagonal expansion originating from Plus', 340);
    }

    function closePlusModal() {
      modalPlusContent.classList.remove('scale-100', 'translate-x-0', 'translate-y-0', 'opacity-100');
      modalPlusContent.classList.add('scale-75', '-translate-x-12', 'translate-y-12', 'opacity-0');
      setTimeout(() => {
        modalPlusWindow.classList.add('opacity-0', 'pointer-events-none');
      }, 250);
      logTelemetry('WINDOW_DISMISS', 'Contracting back toward Plus origin', 280);
    }

    btnPlusOrigin.addEventListener('click', openPlusModal);
    btnClosePlusModal.addEventListener('click', closePlusModal);
    btnCancelPlus.addEventListener('click', closePlusModal);
    btnConfirmPlus.addEventListener('click', closePlusModal);

    // 07. Completion Window & Tick Emergence
    const btnCompleteTick = document.getElementById('btn-complete-tick');
    const completeCheckIcon = document.getElementById('complete-check-icon');
    const modalCompletionSheet = document.getElementById('modal-completion-sheet');
    const modalCompletionContent = document.getElementById('modal-completion-content');
    const btnDismissCompletion = document.getElementById('btn-dismiss-completion');

    btnCompleteTick.addEventListener('click', () => {
      completeCheckIcon.classList.remove('stroke-transparent');
      completeCheckIcon.classList.add('stroke-emerald-400');
      btnCompleteTick.classList.add('bg-emerald-500/20', 'border-emerald-400');
      logTelemetry('TICK_PRESS', 'Checkmark animated → Summary emerges', 320);
      setTimeout(() => {
        modalCompletionSheet.classList.remove('opacity-0', 'pointer-events-none');
        modalCompletionContent.classList.remove('scale-90', 'translate-y-6', 'opacity-0');
        modalCompletionContent.classList.add('scale-100', 'translate-y-0', 'opacity-100');
      }, 200);
    });

    btnDismissCompletion.addEventListener('click', () => {
      modalCompletionContent.classList.remove('scale-100', 'translate-y-0', 'opacity-100');
      modalCompletionContent.classList.add('scale-90', 'translate-y-6', 'opacity-0');
      setTimeout(() => {
        modalCompletionSheet.classList.add('opacity-0', 'pointer-events-none');
        completeCheckIcon.classList.add('stroke-transparent');
        completeCheckIcon.classList.remove('stroke-emerald-400');
        btnCompleteTick.classList.remove('bg-emerald-500/20', 'border-emerald-400');
      }, 250);
      logTelemetry('DISMISS_SUMMARY', 'Returned to originating session card', 260);
    });

    // 08 & 11. Tab Glider Switcher
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabGlider = document.getElementById('tab-glider');
    const tabContentDisplay = document.getElementById('tab-content-display');

    const tabDescriptions = [
      '<span class="text-emerald-400 font-semibold">Study Mode:</span> Active textbook derivation and scratchpad drafting.',
      '<span class="text-sky-400 font-semibold">Revise Mode:</span> Spaced repetition intervals and active recall prompts.',
      '<span class="text-amber-400 font-semibold">Exercise Mode:</span> Deliberate numerical problem sets and timed MCQs.'
    ];

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-index'));
        const label = btn.getAttribute('data-label');
        tabGlider.style.left = `calc(${idx * 33.33}% + 4px)`;
        tabBtns.forEach(b => {
          b.classList.remove('text-slate-950');
          b.classList.add('text-slate-400');
        });
        btn.classList.add('text-slate-950');
        btn.classList.remove('text-slate-400');

        tabContentDisplay.style.opacity = '0';
        tabContentDisplay.style.transform = idx === 0 ? 'translateX(-8px)' : idx === 1 ? 'translateX(0px)' : 'translateX(8px)';
        setTimeout(() => {
          tabContentDisplay.innerHTML = tabDescriptions[idx];
          tabContentDisplay.style.opacity = '1';
          tabContentDisplay.style.transform = 'translateX(0px)';
        }, 120);

        logTelemetry('TAB_SWITCH', `Glider shifted to ${label}`, 200);
      });
    });

    // 10. Retention Slider (Direct continuous tracking)
    const retentionSlider = document.getElementById('retention-slider');
    const sliderValDisplay = document.getElementById('slider-val-display');
    const sliderPillVal = document.getElementById('slider-pill-val');

    retentionSlider.addEventListener('input', (e) => {
      const val = e.target.value;
      sliderValDisplay.textContent = parseFloat(val).toFixed(1) + '%';
      sliderPillVal.textContent = val + '%';
      logTelemetry('SLIDER_DRAG', `Continuous value tracking: ${val}%`, 0);
    });

    // 13 & 14. Graph Expansion
    const graphPreviewBox = document.getElementById('graph-preview-box');
    const modalGraphZoom = document.getElementById('modal-graph-zoom');
    const modalGraphContent = document.getElementById('modal-graph-content');
    const btnCloseGraphModal = document.getElementById('btn-close-graph-modal');

    graphPreviewBox.addEventListener('click', () => {
      modalGraphZoom.classList.remove('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        modalGraphContent.classList.remove('scale-90', 'opacity-0');
        modalGraphContent.classList.add('scale-100', 'opacity-100');
      }, 10);
      logTelemetry('GRAPH_EXPAND', 'Zooming preview into full 7-day analytical matrix', 280);
    });

    btnCloseGraphModal.addEventListener('click', () => {
      modalGraphContent.classList.remove('scale-100', 'opacity-100');
      modalGraphContent.classList.add('scale-90', 'opacity-0');
      setTimeout(() => {
        modalGraphZoom.classList.add('opacity-0', 'pointer-events-none');
      }, 250);
      logTelemetry('GRAPH_COLLAPSE', 'Re-settling into compact card preview', 240);
    });

    // 18. Search Input Focus & Expand
    const searchDemoInput = document.getElementById('search-demo-input');
    const searchClearBtn = document.getElementById('search-clear-btn');
    const searchResultsPreview = document.getElementById('search-results-preview');

    searchDemoInput.addEventListener('focus', () => {
      searchClearBtn.classList.remove('opacity-0');
      searchResultsPreview.style.maxHeight = '60px';
      searchResultsPreview.classList.remove('opacity-0');
      searchResultsPreview.classList.add('opacity-100');
      logTelemetry('SEARCH_FOCUS', 'Input container expands; match drawer ready', 200);
    });

    searchClearBtn.addEventListener('click', () => {
      searchDemoInput.value = '';
      searchDemoInput.blur();
      searchClearBtn.classList.add('opacity-0');
      searchResultsPreview.style.maxHeight = '0px';
      searchResultsPreview.classList.add('opacity-0');
      logTelemetry('SEARCH_CLEAR', 'Input restored to idle state', 160);
    });

    // 19 & 20. Filter & Secondary Calendar Drawer
    const btnFilterTrigger = document.getElementById('btn-filter-trigger');
    const filterCalendarBox = document.getElementById('filter-calendar-box');
    const btnCloseCalendar = document.getElementById('btn-close-calendar');
    let isFilterOpen = false;

    btnFilterTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      isFilterOpen = !isFilterOpen;
      if (isFilterOpen) {
        filterCalendarBox.classList.remove('opacity-0', 'scale-95', '-translate-y-2', 'pointer-events-none');
        logTelemetry('FILTER_TAP', 'Secondary calendar cascade emerged', 220);
      } else {
        filterCalendarBox.classList.add('opacity-0', 'scale-95', '-translate-y-2', 'pointer-events-none');
      }
    });

    btnCloseCalendar.addEventListener('click', () => {
      isFilterOpen = false;
      filterCalendarBox.classList.add('opacity-0', 'scale-95', '-translate-y-2', 'pointer-events-none');
      logTelemetry('CALENDAR_CLOSE', 'Cascade dismissed back into filter', 180);
    });

    // 21. Subtle Data Update
    const dataMetricNum = document.getElementById('data-metric-num');
    const dataMetricBar = document.getElementById('data-metric-bar');
    const dataMetricDiff = document.getElementById('data-metric-diff');
    const btnIncrementData = document.getElementById('btn-increment-data');
    const btnResetData = document.getElementById('btn-reset-data');

    btnIncrementData.addEventListener('click', () => {
      dataMetricNum.textContent = '75%';
      dataMetricDiff.textContent = '+14% Today';
      dataMetricBar.style.width = '75%';
      dataMetricNum.classList.add('text-emerald-300');
      setTimeout(() => dataMetricNum.classList.remove('text-emerald-300'), 300);
      logTelemetry('DATA_MUTATION', 'Value 65% → 75% without flash', 240);
    });

    btnResetData.addEventListener('click', () => {
      dataMetricNum.textContent = '65%';
      dataMetricDiff.textContent = '+4% Today';
      dataMetricBar.style.width = '65%';
      logTelemetry('DATA_MUTATION', 'Value reset to 65%', 240);
    });

    // 23. Transition Interruption Physics
    const btnInterruptTest = document.getElementById('btn-interrupt-test');
    const interruptFill = document.getElementById('interrupt-fill');
    const interruptStatusText = document.getElementById('interrupt-status-text');
    let isFilling = false;

    btnInterruptTest.addEventListener('click', () => {
