    function switchMainTab(tabName) {
      const tabs = ['goals', 'completed', 'incomplete', 'review'];
      tabs.forEach(t => {
        const btn = document.getElementById(`tab-btn-${t}`);
        if (t === tabName) {
          btn.className = 'tab-glider-active px-3.5 py-1.5 rounded-lg text-xs font-medium transition-all';
