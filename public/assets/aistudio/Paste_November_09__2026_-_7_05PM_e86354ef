    function addNewGoalDirective() {
      const input = document.getElementById('inputNewGoalDesc');
      const val = input.value.trim();
      if (!val) return;
      triggerToast(`New Goal "${val.substring(0, 22)}..." Deployed`);
    }

    function scrollRightWindow(elementId) {
      const el = document.getElementById(elementId);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.classList.add('ring-2', 'ring-sky-400');
        setTimeout(() => el.classList.remove('ring-2', 'ring-sky-400'), 900);
      }
    }

    function triggerResync(btn) {
      const originalHTML = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = `
        <svg class="w-3 h-3 animate-spin text-axion-emerald" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
