        </svg>
        <span class="text-axion-emerald text-[10px]">Syncing...</span>
      `;
      setTimeout(() => {
        btn.innerHTML = `
          <svg class="w-3 h-3 text-axion-emerald" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
          </svg>
          <span class="text-axion-emerald text-[10px]">Archived</span>
        `;
        triggerToast('Saved directly to Archive (Internal sync)');
        setTimeout(() => {
          btn.innerHTML = originalHTML;
          btn.disabled = false;
        }, 1500);
      }, 700);
    }

    function triggerFloatingSync(btn) {
      btn.classList.add('animate-spin');
      triggerToast('Global Archive telemetry re-indexed');
      setTimeout(() => {
        btn.classList.remove('animate-spin');
      }, 900);
    }
  </script>
