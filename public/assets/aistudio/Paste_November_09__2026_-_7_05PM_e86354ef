<script>
    let isExpanded = false;

    function togglePreviewExpand() {
      const previewPane = document.getElementById('previewPane');
      const expandIcon = document.getElementById('expandIcon');
      isExpanded = !isExpanded;

      if (isExpanded) {
        previewPane.classList.remove('col-span-5');
        previewPane.classList.add('col-span-8');
        previewPane.nextElementSibling.classList.remove('col-span-7');
        previewPane.nextElementSibling.classList.add('col-span-4');
        expandIcon.style.transform = 'rotate(180deg)';
      } else {
        previewPane.classList.remove('col-span-8');
        previewPane.classList.add('col-span-5');
        previewPane.nextElementSibling.classList.remove('col-span-4');
        previewPane.nextElementSibling.classList.add('col-span-7');
        expandIcon.style.transform = 'rotate(0deg)';
      }
    }

    function setRange(range, btn) {
      document.querySelectorAll('.sub-range-btn').forEach(b => {
        b.classList.remove('bg-white/10', 'text-white', 'border', 'border-white/10');
        b.classList.add('text-slate-400');
      });
      btn.classList.add('bg-white/10', 'text-white', 'border', 'border-white/10');
      btn.classList.remove('text-slate-400');

      const totalTimeEl = document.getElementById('totalStudyTimeVal');
      const previewTag = document.getElementById('previewTag');

      if (range === '1d') {
        totalTimeEl.textContent = '5h 15m';
        previewTag.textContent = 'First Day (Today)';
      } else if (range === '7d') {
        totalTimeEl.textContent = '28h 30m';
        previewTag.textContent = '7 days';
      } else if (range === '30d') {
        totalTimeEl.textContent = '114h 45m';
        previewTag.textContent = '30 days';
      }
    }

    function setMcqRange(range, btn) {
      document.querySelectorAll('.mcq-range-btn').forEach(b => {
        b.classList.remove('bg-white/10', 'text-white', 'border', 'border-white/10');
        b.classList.add('text-slate-400');
      });
      btn.classList.add('bg-white/10', 'text-white', 'border', 'border-white/10');
      btn.classList.remove('text-slate-400');

      const totalMcq = document.getElementById('totalMcqCount');
      if (range === '1d') totalMcq.textContent = '150';
      else if (range === '7d') totalMcq.textContent = '645';
      else if (range === '30d') totalMcq.textContent = '2,480';
    }

    function setGlobalRange(range) {
      document.querySelectorAll('.range-btn').forEach(b => {
        b.classList.remove('bg-emerald-500/20', 'text-emerald-300', 'font-medium', 'border', 'border-emerald-500/30');
        b.classList.add('text-slate-400');
      });
      const targetId = range === '1d' ? 'topRange1' : (range === '7d' ? 'topRange7' : 'topRange30');
      const targetBtn = document.getElementById(targetId);
      if (targetBtn) {
        targetBtn.classList.add('bg-emerald-500/20', 'text-emerald-300', 'font-medium', 'border', 'border-emerald-500/30');
        targetBtn.classList.remove('text-slate-400');
      }
    }

    // Chart segment hover telemetry reflection
    document.querySelectorAll('.chart-segment').forEach(seg => {
      seg.addEventListener('mouseenter', () => {
        const text = seg.getAttribute('data-subj');
        const [subj, percent] = text.split(': ');
        document.getElementById('centerSubjLabel').textContent = subj;
        document.getElementById('centerSubjPercent').textContent = percent.split(' ')[0];
      });
      seg.addEventListener('mouseleave', () => {
        document.getElementById('centerSubjLabel').textContent = 'Total Focus';
        document.getElementById('centerSubjPercent').textContent = '100%';
      });
    });
  </script>
