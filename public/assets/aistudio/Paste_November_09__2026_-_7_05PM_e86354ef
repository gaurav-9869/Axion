<!-- Interactive JavaScript Architecture -->
<script>
    let activeSubject = 'all';
    let activeMode = 'All';
    let activeDate = 'all';

    // Toggle Filter Popover
    const filterBtn = document.getElementById('filterButtonTrigger');
    const filterPopover = document.getElementById('filterPopover');

    function toggleFilterPopover() {
      const isHidden = filterPopover.classList.contains('filter-popover-hidden');
      if (isHidden) {
        filterPopover.classList.remove('filter-popover-hidden');
        filterPopover.classList.add('filter-popover-visible');
      } else {
        filterPopover.classList.add('filter-popover-hidden');
        filterPopover.classList.remove('filter-popover-visible');
      }
    }

    document.addEventListener('click', (e) => {
      if (!filterPopover.contains(e.target) && !filterBtn.contains(e.target)) {
        filterPopover.classList.add('filter-popover-hidden');
        filterPopover.classList.remove('filter-popover-visible');
      }
    });

    function setFilterSubject(subj, btn) {
      activeSubject = subj;
      document.querySelectorAll('.subject-chip').forEach(c => {
        c.className = 'subject-chip px-2.5 py-1 rounded-lg bg-white/5 text-slate-300 hover:text-white text-xs font-mono';
      });
      btn.className = 'subject-chip px-2.5 py-1 rounded-lg bg-axion-emerald text-slate-950 text-xs font-semibold font-mono';
      applyFeedFilters();
    }

    function setFilterMode(mode, btn) {
      activeMode = mode;
      document.querySelectorAll('.mode-chip').forEach(c => {
        c.className = 'mode-chip py-1 rounded-lg bg-white/5 text-slate-300 hover:text-white text-xs font-mono text-center';
      });
      btn.className = 'mode-chip py-1 rounded-lg bg-axion-emerald text-slate-950 font-semibold text-xs font-mono text-center';
      applyFeedFilters();
    }

    function filterByDay(btn, dateStr) {
      activeDate = dateStr;
      document.querySelectorAll('.date-rail-btn').forEach(b => {
        b.className = 'date-rail-btn w-full flex flex-col gap-1 p-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.06] text-slate-400 hover:text-white transition-all text-left';
      });
      if (btn) {
        btn.className = 'date-rail-btn w-full flex flex-col gap-1 p-3 rounded-xl bg-axion-emerald/15 border border-axion-emerald/30 text-white transition-all text-left group';
      }
      applyFeedFilters();
    }

    function resetFilters() {
      activeSubject = 'all';
      activeMode = 'All';
      activeDate = 'all';
      document.getElementById('archiveSearchInput').value = '';
      applyFeedFilters();
    }

    // Search Filtering
    const searchInput = document.getElementById('archiveSearchInput');
    searchInput.addEventListener('input', applyFeedFilters);

    function applyFeedFilters() {
      const q = searchInput.value.toLowerCase().trim();
      const cards = document.querySelectorAll('.session-card');

      cards.forEach(c => {
        const sub = c.getAttribute('data-subject');
        const mode = c.getAttribute('data-mode');
        const text = c.innerText.toLowerCase();
        const date = c.closest('.date-group').getAttribute('data-date');

        const matchSub = (activeSubject === 'all' || sub === activeSubject);
        const matchMode = (activeMode === 'All' || mode === activeMode);
        const matchDate = (activeDate === 'all' || date === activeDate);
        const matchQ = (!q || text.includes(q));

        if (matchSub && matchMode && matchDate && matchQ) {
          c.style.display = 'flex';
        } else {
          c.style.display = 'none';
        }
      });

      document.querySelectorAll('.date-group').forEach(group => {
        const visibleCards = group.querySelectorAll('.session-card[style="display: flex;"]');
        if (visibleCards.length === 0 && (activeSubject !== 'all' || activeMode !== 'All' || activeDate !== 'all' || q !== '')) {
          group.style.display = 'none';
        } else {
          group.style.display = 'block';
        }
      });
    }

    // Detailed In-Situ Inspection Overlay
    function inspectSession(card) {
      const sub = card.getAttribute('data-subject');
      const chap = card.getAttribute('data-chap');
      const mode = card.getAttribute('data-mode');
      const topic = card.getAttribute('data-topic');
      const dur = card.getAttribute('data-duration');
      const active = card.getAttribute('data-active');
      const mcqs = card.getAttribute('data-mcqs');
      const ret = card.getAttribute('data-retention');
      const pstart = card.getAttribute('data-pstart');
      const pend = card.getAttribute('data-pend');
      const friction = card.getAttribute('data-friction');
      const notes = card.getAttribute('data-notes');
      const errors = card.getAttribute('data-errors');
      const ref = card.getAttribute('data-refinements');

      document.getElementById('inspectSubjectBadge').innerText = chap;
      document.getElementById('inspectModeBadge').innerText = mode;
      document.getElementById('inspectTopicTitle').innerText = topic;
      document.getElementById('inspectDuration').innerText = dur;
      document.getElementById('inspectActive').innerText = active;
      document.getElementById('inspectMCQBreakdown').innerText = mcqs;
      document.getElementById('inspectPageStart').innerText = pstart;
      document.getElementById('inspectPageEnd').innerText = pend;
      document.getElementById('inspectFriction').innerText = friction;
      document.getElementById('inspectNotes').innerText = notes;
      document.getElementById('inspectErrors').innerText = errors;
      document.getElementById('inspectRefinements').innerText = ref;

      const retBox = document.getElementById('inspectRetentionContainer');
      if (mode === 'Revision' && ret !== '--') {
        retBox.classList.remove('hidden');
        document.getElementById('inspectRetentionScore').innerText = ret;
      } else {
        retBox.classList.add('hidden');
      }

      document.getElementById('sessionInspectOverlay').classList.remove('hidden');
    }

    function closeInspectOverlay() {
      document.getElementById('sessionInspectOverlay').classList.add('hidden');
    }

    // Scratchpad Modal Viewers
    function openScratchModal(url, title) {
      document.getElementById('scratchModalImg').src = url;
      document.getElementById('scratchModalTitle').innerText = title;
      document.getElementById('scratchModalViewer').classList.remove('hidden');
    }

    function closeScratchModal() {
      document.getElementById('scratchModalViewer').classList.add('hidden');
    }

    // Floating Capsules Toggle
    function toggleFloatingWindow(modalId) {
      const el = document.getElementById(modalId);
      if (!el) return;
      const isHidden = el.classList.contains('hidden');
      ['syncModal', 'addTaskModal', 'chatModal'].forEach(id => {
        const item = document.getElementById(id);
        if (item) item.classList.add('hidden');
      });
      if (isHidden) el.classList.remove('hidden');
    }

    function triggerManualSync() {
      const txt = document.getElementById('syncBtnText');
      txt.innerText = 'Verifying Archive Nodes...';
      setTimeout(() => {
        txt.innerText = '28 Sessions Verified (v4.18)';
      }, 750);
    }

    // Global Dismiss on Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeInspectOverlay();
        closeScratchModal();
        ['syncModal', 'addTaskModal', 'chatModal'].forEach(id => {
          const item = document.getElementById(id);
          if (item) item.classList.add('hidden');
        });
        filterPopover.classList.add('filter-popover-hidden');
        filterPopover.classList.remove('filter-popover-visible');
      }
    });
  </script>
