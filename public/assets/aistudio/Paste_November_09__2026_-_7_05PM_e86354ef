<!-- Vanilla JavaScript: Reversible, Interruptible Interaction Handling -->
<script>
    // State
    let activeTaskElement = null;

    // Toggle Floating Right Trio Windows (Mutually Exclusive)
    function toggleFloatingWindow(windowId) {
      const target = document.getElementById(windowId);
      if (!target) return;
      const isHidden = target.classList.contains('hidden');

      ['addTaskModal', 'syncModal', 'chatModal'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
      });

      if (isHidden) {
        target.classList.remove('hidden');
      }
    }

    // Expandable list selection control helper
    function toggleExpandableList(listId) {
      const list = document.getElementById(listId);
      if (list) list.classList.toggle('hidden');
    }

    function selectSubjectOption(subj, color) {
      document.getElementById('selectedSubjectDisplay').innerText = subj;
      document.getElementById('newDirectiveSubject').value = subj;
      toggleExpandableList('subjectOptionsList');
    }

    function selectDirectiveType(type, btn) {
      document.getElementById('newDirectiveType').value = type;
      document.querySelectorAll('.type-pill').forEach(p => {
        p.className = 'type-pill py-1.5 rounded-lg border border-white/10 text-slate-300 hover:border-emerald-400 text-center transition bg-white/5';
      });
      btn.className = 'type-pill py-1.5 rounded-lg border border-emerald-400 text-emerald-300 bg-emerald-500/20 text-center transition';
    }

    function setDirectiveDuration(mins, btn) {
      document.getElementById('newDirectiveDuration').value = mins + 'm';
      document.querySelectorAll('.dur-preset').forEach(p => {
        p.className = 'dur-preset py-1.5 rounded-lg border border-white/10 text-slate-300 hover:border-emerald-400 text-center transition bg-white/5';
      });
      btn.className = 'dur-preset py-1.5 rounded-lg border border-emerald-400 text-emerald-300 bg-emerald-500/20 text-center transition';
    }

    // Toggle Shortcuts Edit Drawer
    function toggleShortcutsDrawer() {
      const drawer = document.getElementById('shortcutsDrawer');
      drawer.classList.toggle('hidden');
    }

    function handleAddShortcut(e) {
      e.preventDefault();
      const name = document.getElementById('shortcutNameInput').value;
      const subj = document.getElementById('shortcutSubjectInput').value;
      const dur = document.getElementById('shortcutDurationInput').value;

      const container = document.getElementById('shortcutPills');
      const newBtn = document.createElement('button');
      newBtn.className = 'px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-mono text-slate-300 transition';
      newBtn.innerText = name.startsWith('+') ? name : `+ ${name}`;
      newBtn.onclick = () => triggerShortcut(subj, 'Revision', name, parseInt(dur));

      container.appendChild(newBtn);
      toggleShortcutsDrawer();
      document.getElementById('shortcutNameInput').value = '';
    }

    function triggerShortcut(subject, type, topic, duration) {
      // Direct in-place trigger
      openInPlaceSessionWithParams(subject, type, topic, duration);
    }

    // In-Place Overlapping Session Window
    function openInPlaceSession(taskEl, forcedType) {
      activeTaskElement = taskEl;
      const subject = taskEl.getAttribute('data-subject');
      const type = forcedType || taskEl.getAttribute('data-type');
      const topic = taskEl.getAttribute('data-topic');
      const time = taskEl.getAttribute('data-time') || '45m';

      openInPlaceSessionWithParams(subject, type, topic, parseInt(time));
    }

    function openInPlaceSessionWithParams(subject, type, topic, durationMins) {
      const overlay = document.getElementById('inPlaceSessionOverlay');
      document.getElementById('sessionSubjectText').innerText = subject;
      document.getElementById('sessionTopicTitle').innerText = topic;
      
      const badge = document.getElementById('sessionTypeBadge');
      badge.innerText = type;

      // Type Badge Colors
      if (type === 'Revision') {
        badge.className = 'text-xs font-mono px-2.5 py-1 rounded-lg font-semibold border border-sky-500/30 bg-sky-500/15 text-sky-400';
      } else if (type === 'Study') {
        badge.className = 'text-xs font-mono px-2.5 py-1 rounded-lg font-semibold border border-amber-500/30 bg-amber-500/15 text-amber-400';
      } else {
        badge.className = 'text-xs font-mono px-2.5 py-1 rounded-lg font-semibold border border-purple-500/30 bg-purple-500/15 text-purple-400';
      }

      switchSessionStructure(type);
      overlay.classList.remove('hidden');
    }

    function switchSessionStructure(type) {
      const sRev = document.getElementById('structRevision');
      const sStd = document.getElementById('structStudy');
      const sExe = document.getElementById('structExercise');

      sRev.classList.add('hidden');
      sStd.classList.add('hidden');
      sExe.classList.add('hidden');

      const bRev = document.getElementById('tabBtnRevision');
      const bStd = document.getElementById('tabBtnStudy');
      const bExe = document.getElementById('tabBtnExercise');

      [bRev, bStd, bExe].forEach(b => {
        b.className = 'px-2 py-0.5 rounded-lg text-slate-400 hover:text-white transition';
      });

      if (type === 'Revision') {
        sRev.classList.remove('hidden');
        bRev.className = 'px-2 py-0.5 rounded-lg text-sky-300 bg-sky-500/20 font-semibold';
      } else if (type === 'Study') {
        sStd.classList.remove('hidden');
        bStd.className = 'px-2 py-0.5 rounded-lg text-amber-300 bg-amber-500/20 font-semibold';
      } else {
        sExe.classList.remove('hidden');
        bExe.className = 'px-2 py-0.5 rounded-lg text-purple-300 bg-purple-500/20 font-semibold';
      }
    }

    function closeInPlaceSession() {
      document.getElementById('inPlaceSessionOverlay').classList.add('hidden');
    }

    function commitInPlaceSession() {
      if (activeTaskElement) {
        activeTaskElement.classList.add('opacity-60');
        const btn = activeTaskElement.querySelector('button');
        if (btn) {
          btn.outerHTML = '<span class="text-xs font-mono text-emerald-400/80 px-3 py-1.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20">Logged</span>';
        }
      }
      document.getElementById('metric-total-time').innerText = '4h 00m';
      closeInPlaceSession();
    }

    // Create Directive from floating modal
    function handleCreateDirective(e) {
      e.preventDefault();
      const subj = document.getElementById('newDirectiveSubject').value;
      const type = document.getElementById('newDirectiveType').value;
      const chapter = document.getElementById('newDirectiveChapter').value;
      const topic = document.getElementById('newDirectiveTopic').value;
      const pstart = document.getElementById('newDirectivePageStart').value;
      const pend = document.getElementById('newDirectivePageEnd').value;
      const dur = document.getElementById('newDirectiveDuration').value;

      let color = 'sky';
      if (subj === 'Org Chem') color = 'amber';
      if (subj === 'Maths') color = 'purple';
      if (subj === 'Biology') color = 'emerald';

      const list = document.getElementById('directives-list');
      const card = document.createElement('div');
      card.className = `task-card axion-surface-l2 rounded-2xl p-4 border border-white/5 flex items-center justify-between group transition cursor-pointer hover:border-${color}-500/30`;
      card.setAttribute('data-subject', subj);
      card.setAttribute('data-type', type);
      card.setAttribute('data-topic', `${chapter}: ${topic}`);
      card.setAttribute('data-time', dur);
      card.setAttribute('data-pstart', pstart);
      card.setAttribute('data-pend', pend);
      card.onclick = () => openInPlaceSession(card, type);

      card.innerHTML = `
        <div class="flex items-center gap-4">
          <div class="w-3 h-3 rounded-full border-2 border-${color}-400 bg-${color}-400/20 group-hover:scale-110 transition flex-shrink-0"></div>
          <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-${color}-500/15 text-${color}-400 font-semibold border border-${color}-500/20">${subj}</span>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-white/5 text-slate-300">${type}</span>
            </div>
            <h3 class="text-sm font-semibold text-white tracking-wide">${chapter}: ${topic}</h3>
            <div class="text-xs font-mono text-slate-400 flex items-center gap-3">
              <span>${dur}</span>
              <span class="w-1 h-1 rounded-full bg-slate-600"></span>
              <span>p. ${pstart}–${pend}</span>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <button class="px-3.5 py-2 rounded-xl bg-${color}-500/15 text-${color}-400 hover:bg-${color}-500/25 border border-${color}-500/30 font-mono text-xs flex items-center gap-2 transition active:scale-95 shadow-sm" onclick="event.stopPropagation(); openInPlaceSession(this.closest('.task-card'), '${type}');">
            <svg class="ax-icon w-3.5 h-3.5 text-${color}-400"><use href="#ax-play"/></svg>
            <span>Start</span>
          </button>
        </div>
      `;

      list.prepend(card);
      document.getElementById('total-directives-count').innerText = `${list.querySelectorAll('.task-card').length} Tasks`;
      toggleFloatingWindow('addTaskModal');
      document.getElementById('createTaskForm').reset();
    }

    // Telemetry Sync Action
    function triggerManualSync() {
      const text = document.getElementById('syncBtnText');
      text.innerText = 'Synchronizing...';
      setTimeout(() => {
        text.innerText = 'Nodes Synchronized (0ms latency)';
      }, 900);
    }

    // Study Assistant Message
    function handleSendAssistantMessage(e) {
      e.preventDefault();
      const input = document.getElementById('assistantInput');
      const val = input.value.trim();
      if (!val) return;

      const stream = document.getElementById('chatStream');
      const userBubble = document.createElement('div');
      userBubble.className = 'flex gap-2.5 justify-end';
      userBubble.innerHTML = `
        <div class="p-3 rounded-2xl rounded-tr-none bg-emerald-500/15 border border-emerald-500/30 text-emerald-200 leading-relaxed max-w-[85%]">
          ${val}
        </div>
      `;
      stream.appendChild(userBubble);
      input.value = '';

      setTimeout(() => {
        const botBubble = document.createElement('div');
        botBubble.className = 'flex gap-2.5';
        botBubble.innerHTML = `
          <div class="w-6 h-6 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-[10px] font-bold flex-shrink-0">A</div>
          <div class="p-3 rounded-2xl rounded-tl-none bg-white/5 border border-white/5 text-slate-200 leading-relaxed max-w-[85%]">
            Directive noted. Telemetry recorded into local buffer. Ready for execution.
          </div>
        `;
        stream.appendChild(botBubble);
        stream.scrollTop = stream.scrollHeight;
      }, 450);

      stream.scrollTop = stream.scrollHeight;
    }

    // Global Dismiss on Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeInPlaceSession();
        ['addTaskModal', 'syncModal', 'chatModal', 'shortcutsDrawer', 'subjectOptionsList'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.classList.add('hidden');
        });
      }
    });
  </script>


